# Copy to .env and fill in. Never commit .env.

# Supabase anon (public) key — Project Settings > API. NEVER put the service-role key here.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# URL of the deployed "api" edge function:
# https://YOUR_PROJECT_REF.supabase.co/functions/v1/api
VITE_SUPABASE_FUNCTION_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/api

# Telegram bot username without the @
VITE_BOT_USERNAME=your_bot_username
